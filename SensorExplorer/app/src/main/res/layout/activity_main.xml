<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_large"
        android:paddingEnd="@dimen/space_large"
        android:paddingTop="@dimen/screen_vertical_padding"
        android:paddingBottom="@dimen/screen_vertical_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:baselineAligned="false">
            <LinearLayout
                android:layout_width="@dimen/space_zero"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:baselineAligned="false">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_large"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="@dimen/radius_large"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="@dimen/border_thin">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_large">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_title"
                    android:textColor="@color/accent_blue"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_small" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_medium"
                    android:orientation="horizontal"
                    android:baselineAligned="false">
                    <LinearLayout
                        android:layout_width="@dimen/space_zero"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/steps_label" android:textColor="@color/text_secondary" />
                        <TextView android:id="@+id/tvSteps" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/zero" android:textColor="@color/accent_blue" android:textSize="@dimen/text_value_xlarge" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="@dimen/space_zero"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/shakes_label" android:textColor="@color/text_secondary" />
                        <TextView android:id="@+id/tvShakes" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/zero" android:textColor="@color/status_bad" android:textSize="@dimen/text_value_xlarge" android:textStyle="bold"
                            tools:ignore="TextContrastCheck"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_medium"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="@dimen/space_zero"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/sensor_count_label"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_body" />
                    <TextView
                        android:id="@+id/tvSensorCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zero"
                        android:textColor="@color/accent_blue"
                        android:textSize="@dimen/text_value_medium"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_xsmall"
                        android:text="@string/sensor_count_suffix"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_small" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetCounters" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/reset_counters" tools:ignore="TextContrastCheck"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShowSensors"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium"
            android:text="@string/show_sensors" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xlarge" android:text="@string/sensors_found"
            android:textColor="@color/accent_blue" android:textStyle="bold" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sensorRecycler" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_small_plus" android:nestedScrollingEnabled="false" android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium"
            android:orientation="horizontal">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/space_zero" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_small" app:cardBackgroundColor="@color/card" app:cardCornerRadius="@dimen/radius_medium">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="@dimen/space_card_small">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/heading_label" android:textColor="@color/text_secondary" />
                    <TextView android:id="@+id/tvHeading" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/heading_placeholder" android:textColor="@color/accent_green" android:textSize="@dimen/text_value_large" android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/space_zero" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="@dimen/space_small" app:cardBackgroundColor="@color/card" app:cardCornerRadius="@dimen/radius_medium">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="@dimen/space_card_small">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/light_title" android:textColor="@color/text_secondary" />
                    <TextView android:id="@+id/tvLight" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/waiting_data" android:textColor="@color/accent_yellow" android:textSize="@dimen/text_value_medium" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/ambient_light" android:textColor="@color/text_secondary" android:textSize="@dimen/text_xsmall" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCompassStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium"
            app:cardBackgroundColor="@color/status_warning"
            app:cardCornerRadius="@dimen/radius_medium">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="@dimen/space_large">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="@dimen/space_zero" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/compass_reliability" android:textColor="@color/white" android:textStyle="bold" />
                    <TextView android:id="@+id/tvCompassStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/status_unreliable" android:textColor="@color/white" android:textSize="@dimen/text_heading_small" android:textStyle="bold" />
                </LinearLayout>
                <TextView android:id="@+id/tvCompassMessage" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_small" android:text="@string/waiting_sensor_data"
                    android:textColor="@color/white" android:textSize="@dimen/text_body" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium" app:cardBackgroundColor="@color/card" app:cardCornerRadius="@dimen/radius_medium">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="@dimen/space_large">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/compass_diagnostics" android:textColor="@color/accent_blue" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_small_plus" android:orientation="horizontal">
                    <TextView android:layout_width="@dimen/space_zero" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/magnetic_field" android:textColor="@color/text_secondary" />
                    <TextView android:id="@+id/tvMagnetic" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/value_not_available" android:textColor="@color/text_primary" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_small" android:orientation="horizontal">
                    <TextView android:layout_width="@dimen/space_zero" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/heading_variation" android:textColor="@color/text_secondary" />
                    <TextView android:id="@+id/tvVariation" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/value_not_available" android:textColor="@color/text_primary" android:textStyle="bold" />
                </LinearLayout>
                <TextView android:id="@+id/tvAccuracy" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_small" android:text="@string/android_accuracy_waiting"
                    android:textColor="@color/text_secondary" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCompassTest" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_medium" android:text="@string/run_compass_test" />
                <TextView android:id="@+id/tvTestSummary" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_small_plus" android:text="@string/compass_test_hint"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium" app:cardBackgroundColor="@color/card" app:cardCornerRadius="@dimen/radius_medium">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="@dimen/space_large">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/pocket_estimate" android:textColor="@color/accent_purple" android:textStyle="bold" />
                <TextView android:id="@+id/tvPocket" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_small" android:text="@string/waiting_light"
                    android:textColor="@color/text_primary" android:textSize="@dimen/text_heading" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xsmall" android:text="@string/pocket_explanation"
                    android:textColor="@color/text_secondary" android:textSize="@dimen/text_small" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_small"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="@dimen/space_zero"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/proximity_label"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_small" />
                    <TextView
                        android:id="@+id/tvPocketProximity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/value_not_available"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xsmall"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="@dimen/space_zero"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/light_label"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_small" />
                    <TextView
                        android:id="@+id/tvPocketLight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/value_not_available"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>





        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="@dimen/radius_medium">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_large">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/battery_status_title"
                    android:textColor="@color/accent_blue"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvBatteryInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_small"
                    android:text="@string/battery_waiting"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body"
                    android:lineSpacingExtra="@dimen/space_xsmall" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


    </LinearLayout>
</androidx.core.widget.NestedScrollView>
