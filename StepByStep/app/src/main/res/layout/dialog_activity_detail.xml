<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/card"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

    <!-- หัวข้อ (วันที่และเวลาสั้น) -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_large"
        tools:text="วันที่/เดือน/เวลา"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_value_medium" />

    <!-- ช่วงวันที่และเวลา -->
    <TextView
        android:id="@+id/tvDateRange"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_large"

        tools:text="วันที่/เดือน/ปี • เวลา"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_body" />

    <!-- จำนวนก้าว (สีฟ้า) -->
    <TextView
        android:id="@+id/tvSteps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_small_plus"
        android:drawablePadding="@dimen/space_medium"

        tools:text="0 steps"
        android:textColor="@color/accent_blue_cyan"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- จำนวนครั้งที่เขย่า (สีม่วง) -->
    <TextView
        android:id="@+id/tvShakes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_large"
        android:drawablePadding="@dimen/space_medium"

        tools:text="0 shakes"
        android:textColor="@color/accent_purple"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- ระยะเวลา -->
    <TextView
        android:id="@+id/tvDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_medium"

        tools:text="Duration: 00:00"
        android:textColor="@color/text_primary"
        android:textSize="16sp" />

    <!-- ค่าเฉลี่ย -->
    <TextView
        android:id="@+id/tvAverage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_large"
        android:lineSpacingExtra="@dimen/space_xsmall"

        tools:text="Average:\n• 0.0 steps/min\n• 0.0 shakes/min"
        android:textColor="@color/text_primary"
        android:textSize="16sp" />

    <!-- แจ้งเตือนสถิติใหม่ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_medium"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/badgeNewStep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_small"
            android:visibility="gone"
            app:cardBackgroundColor="@color/bg_badge_yellow"
            app:cardCornerRadius="@dimen/radius_small"
            app:strokeWidth="0dp"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/space_small_plus"
                android:paddingVertical="@dimen/space_xsmall"
                android:text="@string/new_step_record"
                android:textColor="@color/accent_yellow"
                android:textSize="@dimen/text_small"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/badgeNewShake"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="@color/bg_badge_yellow"
            app:cardCornerRadius="@dimen/radius_small"
            app:strokeWidth="0dp"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/space_small_plus"
                android:paddingVertical="@dimen/space_xsmall"
                android:text="@string/new_shake_record"
                android:textColor="@color/accent_yellow"
                android:textSize="@dimen/text_small"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- ปุ่มกดด้านล่าง -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- ปุ่มลบ (ซ้าย) -->
        <Button
            android:id="@+id/btnDelete"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="@string/action_delete"
            android:textColor="@color/accent_blue_cyan"
            android:textSize="16sp" />

        <!-- ปุ่มปิด (ขวา) -->
        <Button
            android:id="@+id/btnClose"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="@string/action_close"
            android:textColor="@color/accent_blue_cyan"
            android:textSize="16sp" />
    </RelativeLayout>

</LinearLayout>
</ScrollView>
